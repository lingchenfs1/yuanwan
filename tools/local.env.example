# 开发机上的脚本（deploy-gateway.sh、m0-remote.sh、e8-scheduled.sh）读这个文件。
# 复制成 tools/local.env 再填真实值；tools/local.env 不进仓库。
# 下面都是占位示例（192.0.2.x 是文档专用地址）。

# 网关机的 SSH 登录（用户@地址）
YW_GW_SSH=user@192.0.2.10
# 网关机的地址（链路测量的服务端）
YW_GW_IP=192.0.2.10
# 登录网关机用的私钥
YW_SSH_KEY="${HOME}/.ssh/id_ed25519"
# PS5 的地址（网关机上的脚本优先读网关机的 ~/yw-gw/gateway.conf）
YW_PS5=192.0.2.20
# 开发机连网关机时绑定的物理网卡（避开代理软件的 TUN）
YW_BIND_IF=en0
