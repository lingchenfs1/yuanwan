+CHIAKI_EXPORT ChiakiErrorCode chiaki_takion_send_buffer_ack_range(ChiakiTakionSendBuffer *send_buffer, ChiakiSeqNum32 first, ChiakiSeqNum32 last, ChiakiSeqNum32 *acked_seq_nums, size_t *acked_seq_nums_count)
+{
+	ChiakiErrorCode err = chiaki_mutex_lock(&send_buffer->mutex);
+	if(err != CHIAKI_ERR_SUCCESS)
+		return err;
+
+	// 保持原有顺序做原地压缩：区间内的包释放掉，其余前移
+	size_t w = 0;
+	for(size_t r=0; r<send_buffer->packets_count; r++)
+	{
+		ChiakiTakionSendBufferPacket *packet = &send_buffer->packets[r];
+		bool in_range = !chiaki_seq_num_32_lt(packet->seq_num, first) && !chiaki_seq_num_32_gt(packet->seq_num, last);
+		if(in_range)
+		{
+			if(acked_seq_nums && acked_seq_nums_count)
+				acked_seq_nums[(*acked_seq_nums_count)++] = packet->seq_num;
+			free(packet->buf);
+			continue;
+		}
+		if(w != r)
+			send_buffer->packets[w] = *packet;
+		w++;
+	}
+	send_buffer->packets_count = w;
+
+	chiaki_mutex_unlock(&send_buffer->mutex);
+	return err;
+}
+
+CHIAKI_EXPORT void chiaki_takion_send_buffer_resend_now(ChiakiTakionSendBuffer *send_buffer, ChiakiSeqNum32 seq_num, uint64_t min_age_ms)
+{
+	if(!send_buffer->takion)
+		return;
+	if(chiaki_mutex_lock(&send_buffer->mutex) != CHIAKI_ERR_SUCCESS)
+		return;
+	uint64_t now = chiaki_time_now_monotonic_ms();
+	for(size_t i=0; i<send_buffer->packets_count; i++)
+	{
+		ChiakiTakionSendBufferPacket *packet = &send_buffer->packets[i];
+		if(packet->seq_num != seq_num)
+			continue;
+		if(now - packet->last_send_ms >= min_age_ms && packet->tries < TAKION_DATA_RESEND_TRIES_MAX)
+		{
+			CHIAKI_LOGI(send_buffer->log, "Takion Send Buffer fast re-sending packet with seqnum %#llx (SACK gap), tries: %llu", (unsigned long long)packet->seq_num, (unsigned long long)packet->tries);
+			packet->last_send_ms = now;
+			chiaki_takion_send_raw(send_buffer->takion, packet->buf, packet->buf_size);
+			packet->tries++;
+		}
+		break;
+	}
+	chiaki_mutex_unlock(&send_buffer->mutex);
+}
+
 static void takion_send_buffer_resend(ChiakiTakionSendBuffer *send_buffer);
 
