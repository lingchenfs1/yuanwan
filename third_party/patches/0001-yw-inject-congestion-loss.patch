@@ -25,7 +25,18 @@ static void *congestion_control_thread_func(void *user)
 		ChiakiTakionCongestionPacket packet = { 0 };
 		uint64_t total = received + lost;
 		control->packet_loss = total > 0 ? (double)lost / total : 0;
-		if(control->packet_loss > control->packet_loss_max)
+		double yw_inject = control->yw_inject_loss ? *control->yw_inject_loss : -1.0;
+		if(yw_inject >= 0.0)
+		{
+			// yw 补丁：实验用，按指定丢包率上报（不受 packet_loss_max 限制）
+			if(yw_inject > 1.0)
+				yw_inject = 1.0;
+			lost = (uint64_t)(total * yw_inject + 0.5);
+			received = total - lost;
+			CHIAKI_LOGV(control->takion->log, "[yw-cc] measured=%.4f injected=%.4f total=%llu",
+				control->packet_loss, yw_inject, (unsigned long long)total);
+		}
+		else if(control->packet_loss > control->packet_loss_max)
 		{
 			CHIAKI_LOGD(control->takion->log, "Clamping reported packet loss: measured=%.1f%% reported_max=%.1f%%",
 				control->packet_loss * 100.0, control->packet_loss_max * 100.0);
